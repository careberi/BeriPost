# ============================================================================
#  BeriPost secrets.  COPY this file to ".env" and fill in the real values.
#  NEVER commit the real .env file or share it. It is git-ignored by default.
# ============================================================================

# --- Anthropic (Claude) API -------------------------------------------------
# Get this from https://console.anthropic.com/  -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Facebook Page publishing -----------------------------------------------
# See README.md "Getting a Facebook Page access token" for step-by-step help.
FB_PAGE_ID=000000000000000
FB_PAGE_ACCESS_TOKEN=EAAG...your-long-lived-page-token...

# Graph API version. v25.0 is current as of early 2026. Only change if Meta
# tells you your version is being deprecated (check developers.facebook.com).
GRAPH_API_VERSION=v25.0

# --- Email notification (a copy of each post) -------------------------------
# BeriPost emails you a copy after each post. Fill these to enable it.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# and SMTP_PASS = a Google "App Password" (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=you@example.com

# --- GitHub (optional) ------------------------------------------------------
# Only needed to auto-close feedback issues, or if your repo is PRIVATE.
# Reading feedback from a public repo needs nothing here.
GITHUB_TOKEN=
